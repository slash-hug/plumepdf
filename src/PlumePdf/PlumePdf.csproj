<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Every supported .NET LTS (see PlumeTargetFrameworks in Directory.Build.props). Single package. -->
    <TargetFrameworks>$(PlumeTargetFrameworks)</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>

    <PackageId>PlumePdf</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Description>A fully-featured, high-performance, agent-forward PDF library for .NET. Apache 2.0.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/slash-hug/plumepdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/slash-hug/plumepdf</PackageProjectUrl>
    <Authors>The PlumePDF contributors</Authors>
    <Copyright>Copyright © the PlumePDF contributors</Copyright>
    <PackageTags>pdf;pdf-library;pdf-generation;pdf-parser;text-extraction;acroforms;digital-signatures;pades;pdfa;pdf-ua;redaction;rasterization;jbig2;jpeg2000;nativeaot</PackageTags>
    <PackageReleaseNotes>See https://github.com/slash-hug/plumepdf/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- Rendered from brand/plumepdf-icon.svg (the source of truth); packed at the package root below. -->
    <PackageIcon>plumepdf-icon-128.png</PackageIcon>

    <!-- SourceLink (built into the .NET SDK) + a .snupkg so consumers can step into the source. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Release builds come from CI (.github/workflows/release.yml). ContinuousIntegrationBuild
    normalizes source paths to /_/ so no builder's local path is embedded in the DLL or PDB.
  -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/plumepdf-icon-128.png" Pack="true" PackagePath="/" />
    <!-- Apache-2.0 §4(d): the Core-14 AFM attribution must reach package consumers. -->
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Phase 6: a 456-byte CC0-1.0 compact sRGB v2 ICC profile
    (github.com/saucecontrol/Compact-ICC-Profiles, see NOTICE) PlumePdf.Documents.PdfA.
    OutputIntentBuilder embeds in every PDF/A output intent it builds.

    NOT an <EmbeddedResource>: reading one back via
    Assembly.GetManifestResourceStream is System.Reflection's member-enumeration/invocation
    surface, which PlumePdf.ArchitectureTests.ReflectionBanTests forbids anywhere in src/ (the
    NativeAOT-safety commitment, docs/architecture.md/docs/agent-forward.md "From Phase 2 on")
    — confirmed by that test actually failing when this was first wired up as one. Instead this
    file is the source of record for provenance/NOTICE/regeneration; the bytes actually
    consumed at runtime are a compiled-in literal in OutputIntentBuilder.cs (see its own
    comment for the regeneration command), the same "checked-in generated table, never
    reflection" shape as Fonts/Standard14/Standard14Metrics.g.cs. No explicit item group is
    needed — the SDK's default None glob already includes it, unpacked, which is exactly right
    for a file nothing packs or loads at runtime.
  -->

  <!--
    The package carries one runtime assembly (this project) plus one
    build-time-only Roslyn analyzer assembly under analyzers/dotnet/cs/. The ProjectReference
    both wires PlumePdf.Analyzers in as an analyzer for this project's own build (so the
    library's own code is linted too) and, via the target below, makes its build output
    available to pack once compilation has produced it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\analyzers\PlumePdf.Analyzers\PlumePdf.Analyzers.csproj"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer" />
  </ItemGroup>

  <Target Name="_PackAnalyzerAssembly" AfterTargets="Build" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="..\..\analyzers\PlumePdf.Analyzers\bin\$(Configuration)\netstandard2.0\PlumePdf.Analyzers.dll"
            Pack="true"
            PackagePath="analyzers\dotnet\cs"
            Visible="false" />
    </ItemGroup>
  </Target>

  <!--
    The one runtime dependency: System.Security.Cryptography.Pkcs, Microsoft-owned (BCL),
    NativeAOT-cleared. One reference per TFM, each the Pkcs line matching its runtime, so each
    has zero transitive dependencies (Pkcs 10.x on net8.0 would pull Microsoft.Bcl.Cryptography
    and System.Formats.Asn1). Pinned to an exact patch (never a floating range) so the signing
    surface can't drift under an unreviewed restore. Bump deliberately, in its own PR - never
    silently via a version range. 8.0.1 is the final 8.x release.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[8.0.1]" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.12]" />
  </ItemGroup>

</Project>
