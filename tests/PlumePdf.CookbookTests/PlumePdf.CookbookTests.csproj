<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Verify.Xunit" Version="26.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PlumePdf/PlumePdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recipes open "samples/<name>.pdf": the self-authored corpus fixtures, copied at build. -->
    <None Include="../PlumePdf.CorpusTests/Fixtures/*.pdf" Link="samples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The create-pdfa recipe embeds "fonts/NotoSans-Regular.ttf": the pinned OFL font
         fixtures fetched by scripts/fetch-corpora.sh into gitignored corpora/fonts/. The glob
         copies nothing (and the recipe self-skips, loudly) when they haven't been fetched. -->
    <None Include="../../corpora/fonts/*.ttf" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
